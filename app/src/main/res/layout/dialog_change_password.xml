<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/stitch_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="B&#x1EA3;o m&#x1EAD;t t&#xE0;i kho&#x1EA3;n" android:textColor="@color/accent" android:textSize="11sp"
        android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="&#x110;&#x1ED5;i m&#x1EAD;t kh&#x1EA9;u" android:textColor="@color/ink"
        android:textSize="25sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:layout_marginBottom="18dp"
        android:text="X&#xE1;c nh&#x1EAD;n m&#x1EAD;t kh&#x1EA9;u hi&#x1EC7;n t&#x1EA1;i &#x111;&#x1EC3; c&#x1EAD;p nh&#x1EAD;t an to&#xE0;n cho t&#xE0;i kho&#x1EA3;n c&#x1EE7;a b&#x1EA1;n."
        android:textColor="@color/muted" android:textSize="14sp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="M&#x1EAD;t kh&#x1EA9;u hi&#x1EC7;n t&#x1EA1;i" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/accent"
        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/currentPasswordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="M&#x1EAD;t kh&#x1EA9;u m&#x1EDB;i" app:helperText="&#xCD;t nh&#x1EA5;t 6 k&#xFD; t&#x1EF1;" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/accent"
        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/newPasswordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="Nh&#x1EAD;p l&#x1EA1;i m&#x1EAD;t kh&#x1EA9;u m&#x1EDB;i" app:boxBackgroundMode="outline" app:boxStrokeColor="@color/accent"
        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmPasswordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginTop="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/cancelPasswordChange" style="@style/SecondaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="H&#x1EE7;y" />
        <com.google.android.material.button.MaterialButton android:id="@+id/submitPasswordChange" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="C&#x1EAD;p nh&#x1EAD;t" />
    </LinearLayout>
</LinearLayout>
