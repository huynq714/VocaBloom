<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
                <TextView android:id="@+id/profileBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="@color/ink" android:textSize="32sp" android:clickable="true" android:focusable="true" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hồ sơ người học" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="⚙" android:textColor="@color/muted" android:textSize="21sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:layout_marginTop="6dp" android:background="@drawable/stitch_card" android:elevation="1dp">
                <TextView android:id="@+id/profileInitial" android:layout_width="64dp" android:layout_height="64dp" android:gravity="center" android:text="M" android:textColor="@color/accent" android:textSize="25sp" android:textStyle="bold" android:background="@drawable/stitch_pill" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Người học VocaBloom" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/accountStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="email@example.com" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/memberBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="✦  Học viên VocaBloom" android:textColor="@color/on_primary_fixed" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/stitch_pill" />
                </LinearLayout>
                <TextView android:id="@+id/editName" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="✎" android:textColor="@color/accent" android:textSize="19sp" android:clickable="true" android:focusable="true" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/stitch_card" android:elevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="10dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="⚑" android:textColor="@color/accent" android:textSize="19sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mục tiêu học tập" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="Tùy biến" android:textColor="@color/muted" android:textSize="10sp" android:background="@drawable/stitch_soft" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginTop="14dp" android:background="@drawable/stitch_soft">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mục tiêu mỗi ngày" android:textColor="@color/muted" android:textSize="12sp" />
                        <TextView android:id="@+id/goalValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="10 từ / ngày" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <EditText android:id="@+id/goalInput" android:layout_width="88dp" android:layout_height="48dp" android:gravity="center" android:inputType="number" android:singleLine="true" android:text="10" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/stitch_input" android:contentDescription="Số từ mục tiêu mỗi ngày" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:layout_marginTop="8dp" android:background="@drawable/stitch_soft">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Khung giờ nhắc nhở học" android:textColor="@color/muted" android:textSize="12sp" />
                        <TextView android:id="@+id/reminderTime" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:layout_marginTop="4dp" android:text="◷  20:30 mỗi tối · Chạm để đổi giờ" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                    <Switch android:id="@+id/reminderToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:buttonTint="@color/accent" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/saveGoal" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="Lưu mục tiêu" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingStart="4dp" android:text="CÀI ĐẶT TÀI KHOẢN" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:background="@drawable/stitch_card" android:elevation="1dp">
                <TextView android:id="@+id/resetPassword" android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="✎    Đổi mật khẩu trực tiếp     ›" android:textColor="@color/ink" android:textSize="14sp" android:clickable="true" android:focusable="true" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="18dp" android:text="↪   Đăng xuất tài khoản" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="VocaBloom v0.5 • Bản quyền tiếng Việt" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_nav" />
</LinearLayout>
