<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@color/paper">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
            <TextView android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="@color/ink" android:textSize="34sp" android:clickable="true" android:focusable="true" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/sessionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Chủ đề: Daily Life" android:textColor="@color/ink" android:textSize="17sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/counter" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="1 / 10 từ" android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/cardAudio" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:drawableTop="@drawable/ic_volume" android:contentDescription="Phát âm" />
            <TextView android:id="@+id/cardStar" android:layout_width="44dp" android:layout_height="48dp" android:gravity="center" android:text="☆" android:textColor="@color/ink" android:textSize="25sp" android:contentDescription="Lưu yêu thích" />
        </LinearLayout>
        <ProgressBar android:id="@+id/sessionProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:progressTint="@color/accent" android:progressBackgroundTint="@color/divider" />
    </LinearLayout>
    <ScrollView android:id="@+id/cardScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="440dp" android:gravity="center" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
            <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="400dp" android:minHeight="360dp" android:orientation="vertical" android:gravity="center" android:padding="20dp" android:background="@drawable/stitch_card" android:elevation="2dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/partOfSpeech" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="Tính từ • Adjective" android:textColor="@color/muted" android:textSize="12sp" android:background="@drawable/stitch_soft" />
                    <TextView android:id="@+id/flipHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="☞ Chạm để lật" android:textColor="@color/muted" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/word" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Resilient" android:textColor="@color/ink" android:textSize="36sp" android:textStyle="bold" android:fontFamily="@font/literata_bold" />
                    <TextView android:id="@+id/phonetic" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="6dp" android:textColor="@color/accent" android:textSize="16sp" />
                    <TextView android:id="@+id/meaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="14dp" android:gravity="start|center_vertical" android:textColor="@color/ink" android:textStyle="bold" android:textSize="18sp" android:background="@drawable/stitch_soft" android:visibility="gone" />
                    <TextView android:id="@+id/example" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="13dp" android:textColor="@color/muted" android:textSize="14sp" android:fontFamily="sans-serif" android:background="@drawable/stitch_soft" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/synonyms" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="12dp" android:text="Gợi ý ghi nhớ • Chạm để xem nghĩa" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="⟳  Chạm vào thẻ để xem nghĩa và ví dụ" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="18dp" android:background="@drawable/stitch_soft" android:elevation="4dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingBottom="8dp" android:text="MỨC ĐỘ GHI NHỚ CỦA BẠN" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/forgot" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="Chưa nhớ\nLặp lại ngay" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/hard" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="Phân vân\nÔn sau 1 ngày" android:textSize="13sp" android:textColor="@color/amber" app:backgroundTint="@color/soft_amber" app:strokeColor="@color/amber_outline" />
            <com.google.android.material.button.MaterialButton android:id="@+id/remember" style="@style/PrimaryButton" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Đã thuộc\nÔn sau 4 ngày" android:textSize="13sp" app:backgroundTint="@color/green" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
