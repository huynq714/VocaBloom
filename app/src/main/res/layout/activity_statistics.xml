<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
                <TextView android:id="@+id/statsBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="@color/ink" android:textSize="32sp" android:clickable="true" android:focusable="true" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tiến độ học tập" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bản cập nhật hôm nay" android:textColor="@color/muted" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:id="@+id/statsStreak" android:layout_width="84dp" android:layout_height="40dp" android:gravity="center" android:text="🔥 0 ngày" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/stitch_soft" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="8dp" android:background="@drawable/stitch_card" android:elevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GÓI TỪ VỰNG CƠ BẢN" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:id="@+id/statWords" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                            <TextView android:id="@+id/statTotalLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" / 30 từ" android:textColor="@color/muted" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <FrameLayout android:layout_width="68dp" android:layout_height="68dp">
                        <ProgressBar android:id="@+id/overallProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:rotation="-90" android:progressDrawable="@drawable/progress_circular" android:max="100" android:progress="0" />
                        <TextView android:id="@+id/overallPercent" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="0%" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/stitch_soft">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="▤" android:textColor="@color/accent" android:textSize="17sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Đã học" android:textColor="@color/muted" android:textSize="10sp" />
                        <TextView android:id="@+id/statWordsMetric" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="0 từ" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/stitch_soft">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="🔥" android:textColor="@color/accent" android:textSize="17sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Chuỗi ngày" android:textColor="@color/muted" android:textSize="10sp" />
                        <TextView android:id="@+id/statStreakMetric" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="0 ngày" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/stitch_soft">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="◷" android:textColor="@color/muted" android:textSize="17sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Từ chưa thuộc" android:textColor="@color/muted" android:textSize="10sp" />
                        <TextView android:id="@+id/statTimeMetric" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="0 từ" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="22dp" android:layout_marginBottom="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chủ đề demo đang học" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                <TextView android:id="@+id/statTopicCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 / 3 chủ đề" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/topicProgressList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="20dp" android:layout_marginBottom="10dp">
                <TextView android:id="@+id/reviewAgainTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="&#x00D4;n t&#x1EAD;p l&#x1EA1;i" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="@font/literata_semibold" />
                <TextView android:id="@+id/reviewAgainCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 t&#x1EEB; c&#x1EA7;n &#x00F4;n" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/reviewAgainList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/include_nav" />
</LinearLayout>


