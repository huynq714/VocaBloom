<resources>
 <style name="Theme.VocaBloom" parent="Theme.MaterialComponents.Light.NoActionBar">
  <item name="colorPrimary">@color/ink</item><item name="colorPrimaryVariant">@color/ink</item><item name="colorSecondary">@color/accent</item>
  <item name="android:statusBarColor">@color/paper</item><item name="android:windowLightStatusBar">true</item>
  <item name="android:navigationBarColor">@color/paper</item><item name="android:windowBackground">@color/paper</item>
  <item name="android:fontFamily">sans-serif</item>
 </style>
 <style name="TitleLarge"><item name="android:textColor">@color/ink</item><item name="android:fontFamily">@font/literata_bold</item><item name="android:textStyle">bold</item><item name="android:textSize">28sp</item></style>
 <style name="SectionTitle"><item name="android:textColor">@color/ink</item><item name="android:fontFamily">@font/literata_semibold</item><item name="android:textStyle">bold</item><item name="android:textSize">18sp</item></style>
 <style name="Eyebrow"><item name="android:textColor">@color/muted</item><item name="android:textSize">11sp</item><item name="android:letterSpacing">0.10</item></style>
 <style name="BodyMuted"><item name="android:textColor">@color/muted</item><item name="android:textSize">14sp</item></style>
 <style name="PrimaryButton" parent="Widget.MaterialComponents.Button"><item name="backgroundTint">@color/accent</item><item name="android:textColor">@color/surface</item><item name="cornerRadius">11dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="android:minHeight">54dp</item></style>
 <style name="SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton"><item name="strokeColor">@color/divider</item><item name="android:textColor">@color/ink</item><item name="cornerRadius">11dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item><item name="android:minHeight">50dp</item></style>
</resources>
